{
  "name": "agentfootprint-lens",
  "version": "0.38.0",
  "description": "See through your agent's decisions. React components for debugging agentfootprint runs — messages, prompts, tool calls, decision scope, cost.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:record": "npx --yes tsx demo/generate-skill-run.ts",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "coverage:badge": "npm run test:coverage; node scripts/coverage-badge.mjs"
  },
  "keywords": [
    "agentfootprint",
    "footprintjs",
    "agent",
    "llm",
    "observability",
    "debugger",
    "explainable-ai",
    "react",
    "time-travel"
  ],
  "author": "Sanjay Krishna Anbalagan",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/agentfootprint-lens.git"
  },
  "homepage": "https://github.com/footprintjs/agentfootprint-lens#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/agentfootprint-lens/issues"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "agentfootprint": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "footprint-explainable-ui": ">=0.28.0 <1.0.0",
    "footprintjs": "^9.10.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@xyflow/react": "^12.10.2",
    "agentfootprint": "^9.49.0",
    "footprint-explainable-ui": ">=0.32.0 <1.0.0",
    "footprintjs": "^9.10.0",
    "jsdom": "^29.0.2",
    "publint": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "~5.4.5",
    "vitest": "^4.1.4",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "dagre": "^0.8.5"
  }
}
